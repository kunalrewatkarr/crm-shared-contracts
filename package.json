{
  "name": "@nexhub/contracts",
  "version": "0.1.0",
  "description": "Shared TypeScript contracts for NexHub CRM",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "lint": "npm run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/**/*.test.js 2>/dev/null || node -e \"console.log('no unit tests yet')\""
  },
  "files": ["dist"],
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
